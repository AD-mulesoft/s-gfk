			<scheduling-strategy >
				<fixed-frequency frequency="1" startDelay="1" timeUnit="DAYS" />
			</scheduling-strategy>
		</scheduler>
		<ee:transform doc:name="Init vars" doc:id="13fa2537-2b45-41f7-8e7c-f84f90af3250">
			<ee:message />
